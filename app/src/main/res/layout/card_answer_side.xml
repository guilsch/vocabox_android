<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back_ground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_height"
        android:layout_marginHorizontal="0dp"
        android:background="@drawable/bg_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/back_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:background="@drawable/selector_back_layout"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:rotation="180"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_chevron_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="@string/button_back_str"
                android:textColor="@color/header_back"
                android:textSize="@dimen/back_text"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/back_arrow"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/body_horizontal_margin"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="@dimen/body_bottom_margin"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <!-- Progression -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ProgressBar
                android:id="@+id/remaining_cards_progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:progressDrawable="@drawable/progress_bar_custom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cards_left"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/cards_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:text="TextView"
                android:textSize="@dimen/N"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Carte : le mot (compact) en haut, la définition dessous (défile si elle est longue).
             height 0dp + weight 1 = la carte prend tout l'espace que les boutons ne prennent pas. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_answer">

            <!-- item1 : le mot, sur une seule ligne avec le haut-parleur -->
            <TextView
                android:id="@+id/answer_side_item1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingTop="15dp"
                android:paddingEnd="5dp"
                android:paddingBottom="10dp"
                android:text="item1"
                android:textColor="@color/blue3"
                android:textSize="@dimen/XXL"
                android:textStyle="bold"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/speaker_ic"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/speaker_ic"
                android:layout_width="@dimen/ic_size"
                android:layout_height="@dimen/ic_size"
                android:layout_marginEnd="15dp"
                app:layout_constraintBottom_toBottomOf="@+id/answer_side_item1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/answer_side_item1"
                app:layout_constraintTop_toTopOf="@+id/answer_side_item1"
                app:srcCompat="@drawable/selector_speaker" />

            <!-- Fine ligne de séparation -->
            <View
                android:id="@+id/separation_line"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="15dp"
                android:alpha="0.2"
                android:background="@color/blue3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/answer_side_item1" />

            <!-- item2 : la définition, dans une zone qui défile -->
            <androidx.core.widget.NestedScrollView
                style="@style/NoScrollViewEdgeEffect"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separation_line">

                <TextView
                    android:id="@+id/answer_side_item2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|top"
                    android:padding="15dp"
                    android:text="TextView"
                    android:textColor="@color/blue3"
                    android:textSize="@dimen/titles" />
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Les 4 boutons : toujours visibles en bas, hors de la zone qui défile -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">

            <life.sabujak.roundedbutton.RoundedButton
                android:id="@+id/answer_side_button1"
                android:layout_width="@dimen/button_ans_width"
                android:layout_height="@dimen/button_ans_height"
                app:buttonCornerRadius="7dp"
                app:buttonGradientEndColor="@color/main"
                app:buttonGradientStartColor="#FF0000"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <life.sabujak.roundedbutton.RoundedButton
                android:id="@+id/answer_side_button2"
                android:layout_width="58dp"
                android:layout_height="@dimen/button_ans_height"
                app:buttonCornerRadius="7dp"
                app:buttonGradientEndColor="#ECB039"
                app:buttonGradientStartColor="@color/main"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/answer_side_button3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/answer_side_button1"
                app:layout_constraintTop_toTopOf="@+id/answer_side_button1" />

            <life.sabujak.roundedbutton.RoundedButton
                android:id="@+id/answer_side_button3"
                android:layout_width="@dimen/button_ans_width"
                android:layout_height="@dimen/button_ans_height"
                app:buttonCornerRadius="7dp"
                app:buttonGradientEndColor="#E0EC39"
                app:buttonGradientStartColor="#ECB039"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/answer_side_button4"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/answer_side_button2"
                app:layout_constraintTop_toTopOf="@+id/answer_side_button1" />

            <life.sabujak.roundedbutton.RoundedButton
                android:id="@+id/answer_side_button4"
                android:layout_width="@dimen/button_ans_width"
                android:layout_height="@dimen/button_ans_height"
                app:buttonCornerRadius="7dp"
                app:buttonGradientEndColor="#3A7C00"
                app:buttonGradientStartColor="#E0EC39"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/answer_side_button1" />

            <ImageView
                android:layout_width="39dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/answer_side_button4"
                app:layout_constraintEnd_toEndOf="@+id/answer_side_button4"
                app:layout_constraintStart_toStartOf="@+id/answer_side_button4"
                app:layout_constraintTop_toTopOf="@+id/answer_side_button4"
                app:srcCompat="@drawable/ic_smiling_line_icon" />

            <ImageView
                android:layout_width="39dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/answer_side_button3"
                app:layout_constraintEnd_toEndOf="@+id/answer_side_button3"
                app:layout_constraintStart_toStartOf="@+id/answer_side_button3"
                app:layout_constraintTop_toTopOf="@+id/answer_side_button3"
                app:srcCompat="@drawable/ic_confused_line_icon" />

            <ImageView
                android:layout_width="39dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/answer_side_button2"
                app:layout_constraintEnd_toEndOf="@+id/answer_side_button2"
                app:layout_constraintStart_toStartOf="@+id/answer_side_button2"
                app:layout_constraintTop_toTopOf="@+id/answer_side_button2"
                app:srcCompat="@drawable/ic_strange_emoji_icon" />

            <ImageView
                android:layout_width="39dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/answer_side_button1"
                app:layout_constraintEnd_toEndOf="@+id/answer_side_button1"
                app:layout_constraintStart_toStartOf="@+id/answer_side_button1"
                app:layout_constraintTop_toTopOf="@+id/answer_side_button1"
                app:srcCompat="@drawable/ic_crying_line_icon" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>